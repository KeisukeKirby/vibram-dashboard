generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NormalizedSale {
  id           String   @id @default(cuid())
  date         DateTime
  store        String
  channel      String?
  product_name String
  size         String?
  color        String?
  quantity     Int
  amount       Float
  source_file  String
  source_type  String
  importedAt   DateTime @default(now())
}

model InventorySnapshot {
  id                String   @id @default(cuid())
  product_name      String
  size              String?
  color             String?
  storeName         String?
  snapshotDate      DateTime
  stockQuantity     Int
  importedAt        DateTime @default(now())
}

model ImportLog {
  id                String   @id @default(cuid())
  fileName          String
  sourceType        String
  importedAt        DateTime @default(now())
  status            String   // 'SUCCESS', 'FAILED', 'PARTIAL'
  totalRows         Int
  failedRows        Int
  errorMessage      String?
}

model Event {
  id         String       @id @default(cuid())
  slug       String?      @unique
  title      String
  venue      String
  location   String?
  startDate  DateTime
  endDate    DateTime
  brands     String[]
  promotions String?
  notes      String?
  storeKey   String?      // matches NormalizedSale.store to show sales during the event period
  media      EventMedia[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model EventMedia {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String   // 'image' | 'video'
  url       String
  posterUrl String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId])
}
